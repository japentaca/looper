redis_host=127.0.0.1
redis_port=6379
# vacío si el Redis no tiene clave
redis_password=
service_port=31200
# Rutas absolutas con "/". storage_path DEBE terminar en "/" (se concatena con user_id + "/")
storage_path=C:/ruta/a/looper/storage/audio/
db_file=C:/ruta/a/looper/storage/db.sqlite
# ffmpeg/ffprobe: por defecto se usan los binarios de los paquetes npm ffmpeg-static y ffprobe-static.
# Override opcional (dejar vacío o comentado para usar los del paquete):
#path_to_ffmpeg=C:/ruta/a/ffmpeg/bin/ffmpeg.exe
#path_to_ffprobe=C:/ruta/a/ffmpeg/bin/ffprobe.exe
# subidas: cuota por defecto en segundos de audio (users.max_seconds en null usa esta; 1200 = 20 min)
default_max_seconds=1200
# subidas: se rechazan todas si el disco de storage_path tiene menos de estos GB libres
disk_min_free_gb=10
# secreto para firmar la cookie de sesión (obligatorio). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarlo cierra todas las sesiones.
session_secret=
# orígenes permitidos por CORS, separados por coma
cors_origin=http://localhost:31201
