# Datos de conexión para deploy/deploy.sh. Copiar a deploy/.env.deploy (ignorado por git) y
# completar. Este archivo de ejemplo está versionado: NO poner acá IPs, puertos, usuarios ni claves
# reales. Lo más simple es dejar todo en ~/.ssh/config y acá solo el alias:
#
#   Host <alias>
#     HostName <ip o nombre>
#     Port <puerto ssh>
#     User <usuario con sudo>
#     IdentityFile ~/.ssh/<clave>

# Alias de ~/.ssh/config (o nombre del host). Obligatorio.
DEPLOY_HOST=jape-pruebas

# Opcionales: si quedan vacíos se usan los de ~/.ssh/config.
DEPLOY_PORT=
DEPLOY_USER=

# En el servidor (los valores por defecto son los del plan; cambiarlos solo si la instalación difiere).
# Solo letras, números y _ . / : @ ? = & -
DEPLOY_APP_USER=looper
DEPLOY_APP_DIR=/var/lib/looper/looper
DEPLOY_BRANCH=main
DEPLOY_SERVICE=pm2-looper
# Chequeo después del restart (desde el propio servidor; el puerto es el service_port del backend/.env)
DEPLOY_HEALTH_URL=http://127.0.0.1:31200/api/public/projects
